{
  "name": "aqua-ai-tools-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=20.0.0" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:vite": "vite",
    "dev:proxy": "node proxy/server.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:smoke",
    "test:smoke": "node scripts/smoke.mjs && node scripts/privacy-smoke.mjs && node scripts/operations-smoke.mjs",
    "test:privacy": "node scripts/privacy-smoke.mjs",
    "test:operations": "node scripts/operations-smoke.mjs",
    "release:check": "node scripts/release-check.mjs",
    "check": "npm run test:smoke && npm run build && npm run release:check"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^6.4.3"
  }
}
