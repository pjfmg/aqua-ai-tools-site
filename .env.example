# Never commit real secrets.
# Supabase Auth (VITE_* values are public browser configuration; never use the service-role key here.)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Enables durable API rate limits and audit events; never expose as VITE_*.
SUPABASE_SERVICE_ROLE_KEY=
AQUA_OS_COMMERCE_URL=
AQUA_OS_DATA_URL=
AQUA_OS_PRODUCT_KEY=
AQUA_RELEASE=
# Keep false until a Google-certified CMP is live and publishing IAB TCF consent strings.
VITE_ADSENSE_TCF_READY=false
