# Never commit real secrets.
# Supabase Auth (VITE_* values are public browser configuration; never use the service-role key here.)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Enables durable API rate limits and audit events; never expose as VITE_*.
SUPABASE_SERVICE_ROLE_KEY=
AQUA_OS_COMMERCE_URL=
AQUA_OS_DATA_URL=
AQUA_OS_PRODUCT_KEY=
AQUA_RELEASE=
# Advertising interlock only. It never replaces consent or TCF evidence.
VITE_ADSENSE_TCF_READY=false
# Trust Platform operational evidence. Keep false until each gate is verified.
VITE_CMP_CERTIFIED=false
VITE_TCF_VERSION=2.3
VITE_ADSENSE_SITE_APPROVED=false
VITE_ADS_TXT_AUTHORIZED=false
VITE_ADVERTISING_EMERGENCY_STOP=false
# eea, uk, ch, other, or unknown. Unknown applies the strict TCF rule.
VITE_ADVERTISING_REGION=unknown
